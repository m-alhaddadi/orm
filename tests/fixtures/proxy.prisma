enum Status {
  ACTIVE @map("active")
  OLD @map("old")
  @@storage(text)
}
model User {
  id Int @id
  name String?
  status Status @default(OLD)
  settings Json?
  active Boolean @default(false)
  volume Int @default(1)
  @@map("proxy_05_users")
}
model Active {
  name     String         @client_default("client")
  status   Status(ACTIVE) @client_default(ACTIVE)
  settings Json?          @client_default("{\"labels\": [\"proxy\", null], \"limit\": 3}")
  active   Boolean        @client_default(true)
  volume   Int            @client_default(7)
  @@proxy.of(User)
}
model Post {
  id Int @id
  user_id Int
  user Active @relation(fields: [user_id], references: [id])
  @@map("proxy_05_posts")
}
