+// ---- TEMP PROFILING PROBES (not committed) ----
+#[pyfunction]
+fn _probe_plan(schema: &Bound<'_, PySchema>, op_json: &str, params: Vec<Bound<'_, PyAny>>, n: usize) -> PyResult<(f64, f64, f64)> {
+    let s = schema.get().inner.clone();
+    let t = Target::new(Dialect::Postgres);
+    let (mut a, mut b, mut c) = (0u128, 0u128, 0u128);
+    for _ in 0..n {
+        let t0 = std::time::Instant::now();
+        let op = parse_op(op_json)?;
+        let t1 = std::time::Instant::now();
+        let plan = Planner::plan(&s, t, &op, &params)?;
+        let t2 = std::time::Instant::now();
+        let built = match &plan { Plan::Select(p) => db::build(Dialect::Postgres, &p.stmt), Plan::Count(x) | Plan::Exists(x) => db::build(Dialect::Postgres, x), _ => unreachable!() };
+        std::hint::black_box(&built);
+        let t3 = std::time::Instant::now();
+        a += (t1 - t0).as_nanos(); b += (t2 - t1).as_nanos(); c += (t3 - t2).as_nanos();
+    }
+    let n = n as f64;
+    Ok((a as f64 / n / 1e3, b as f64 / n / 1e3, c as f64 / n / 1e3))
+}
