+#[pyfunction]
+fn _probe_rust_loop(py: Python<'_>, engine: &Bound<'_, Engine>, sql: String, n: usize) -> PyResult<f64> {
+    let conn = engine.borrow().conn(None);
+    py.detach(|| pyo3_async_runtimes::tokio::get_runtime().block_on(async move {
+        let t = std::time::Instant::now();
+        for _ in 0..n { conn.query(sql.clone(), vec![]).await.map_err(db_err)?; }
+        Ok(t.elapsed().as_nanos() as f64 / n as f64 / 1e3)
+    }))
+}
