+#[pyfunction]
+fn _probe_efd_noop(fd: i32) {
+    pyo3_async_runtimes::tokio::get_runtime().spawn(async move { efd_signal(fd) });
+}
+fn efd_signal(fd: i32) {
+    use std::io::Write;
+    use std::os::fd::{FromRawFd, IntoRawFd};
+    let mut f = unsafe { std::fs::File::from_raw_fd(fd) };
+    let _ = f.write_all(&1u64.to_ne_bytes());
+    let _ = f.into_raw_fd();
+}
+static EFD_SLOT: std::sync::Mutex<Option<usize>> = std::sync::Mutex::new(None);
+#[pyfunction]
+fn _probe_efd_select(engine: &Bound<'_, Engine>, sql: String, fd: i32) {
+    let conn = engine.borrow().conn(None);
+    pyo3_async_runtimes::tokio::get_runtime().spawn(async move {
+        let n = conn.query(sql, vec![]).await.map(|r| r.len()).unwrap_or(0);
+        *EFD_SLOT.lock().unwrap() = Some(n);
+        efd_signal(fd)
+    });
+}
+#[pyfunction]
+fn _probe_efd_take() -> Option<usize> { EFD_SLOT.lock().unwrap().take() }
+
+type CacheEntry = (String, Vec<sea_query::Value>, Vec<ValueType>, usize);
+static PLAN_CACHE: std::sync::Mutex<Option<std::collections::HashMap<String, CacheEntry>>> = std::sync::Mutex::new(None);
+/// Upper bound of a plan cache: keyed by the IR JSON, reuses SQL + args (params converted but ignored).
+#[pyfunction]
+#[pyo3(signature = (engine, op_json, params, db = None))]
+fn _probe_run_cached<'py>(py: Python<'py>, engine: &Bound<'py, Engine>, op_json: &str, params: Vec<Bound<'py, PyAny>>, db: Option<Bound<'py, PyAny>>) -> PyResult<Bound<'py, PyAny>> {
+    let e = engine.borrow();
+    let hit = PLAN_CACHE.lock().unwrap().get_or_insert_with(Default::default).get(op_json).cloned();
+    let (sql, args, types, model) = match hit {
+        Some(h) => {
+            for p in &params { std::hint::black_box(convert::py_to_value(p, None)?); }
+            h
+        }
+        None => {
+            let op = parse_op(op_json)?;
+            let Plan::Select(p) = Planner::plan(&e.schema, e.target, &op, &params)? else { unreachable!() };
+            let plan::Output::Instances { model, .. } = p.output else { unreachable!() };
+            let (sql, args) = db::build(e.target.dialect, &p.stmt);
+            let entry = (sql, args, p.types.clone(), model);
+            PLAN_CACHE.lock().unwrap().as_mut().unwrap().insert(op_json.to_owned(), entry.clone());
+            entry
+        }
+    };
+    let conn = e.conn(None);
+    let classes = e.classes.clone();
+    let db = db.map(Bound::unbind);
+    pyo3_async_runtimes::tokio::future_into_py(py, async move {
+        let rows = conn.query(sql, args).await.map_err(db_err)?;
+        Python::attach(|py| {
+            let db = db.map(|d| d.into_bound(py));
+            Builder::new(py, &classes, db.as_ref()).model_rows(model, rows.as_ref(), &types).map(|l| l.unbind())
+        })
+    })
+}
