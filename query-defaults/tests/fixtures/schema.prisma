datasource db { provider = "sqlite" }
model Policy {
  id Int @id @default(autoincrement())
  active Boolean @default(true)
  name String
  bio String @query.selectOut
  @@query.defaults(filter: "active == true", fields: ["id", "name"])
}
model Scoped {
  id      Int @id @default(autoincrement())
  shop_id Int
  @@query.filter("shop_id == scope.shop")
}
